/*
 * Profile for the local GPU server (AlphaFold / ColabFold workflow).
 * Adjust queue, GPU request, and container to match your site.
 */

params {
    max_cpus   = 16
    max_memory = '64.GB'
    max_time   = '72.h'
}

process {
    executor = 'local'

    withLabel: gpu {
        cpus   = 8
        memory = '32.GB'
        time   = '24.h'
        // SLURM example (uncomment / adapt):
        // executor = 'slurm'
        // clusterOptions = '--gres=gpu:1'
        // container = 'docker://ghcr.io/sokrypton/colabfold:1.5.5'
    }

    withLabel: process_low {
        cpus   = 2
        memory = '8.GB'
    }
}
