/*
 * GraftingGeneFamilies — Nextflow configuration
 */

manifest {
    name            = 'GraftingGeneFamilies'
    author          = 'Susan Strickler'
    homePage        = 'https://github.com/'
    description     = 'OrthoFinder gene-family pipeline for plant proteomes with functional annotation and % identity tables'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params {
    // Inputs
    species_yaml        = "${projectDir}/conf/species.yaml"
    genes_of_interest   = "${projectDir}/data/genes_of_interest.txt"
    outdir              = "${projectDir}/results"

    // OrthoFinder
    orthofinder_threads = 16
    orthofinder_extra   = ''

    // Annotation toggles (set false to skip a tool)
    run_eggnog          = true
    run_interproscan    = true
    run_signalp         = true
    run_deeptmhmm       = true

    // Tool paths / DBs (override on the remote server)
    eggnog_data_dir     = null          // e.g. /data/dbs/eggnog
    interproscan_dir    = null          // e.g. /opt/interproscan
    signalp_bin         = 'signalp'     // or absolute path to signalp6
    deeptmhmm_bin       = 'biolib'      // DeepTMHMM is often run via biolib

    // QC
    keep_longest_isoform = true
    drop_alt_haplotigs   = true
    haplotig_patterns    = 'hap|haplotig|alt_?hap|_H2|unanchored_hap'

    // BUSCO proteome completeness gate (protein mode)
    // Species below busco_min_complete are excluded from OrthoFinder onward
    run_busco            = true
    busco_lineage        = 'embryophyta_odb10'  // override per species in species.yaml
    busco_min_complete   = 90.0                 // % Complete (Single + Duplicated)
    busco_download_path  = null                 // shared BUSCO DB dir on the server
    busco_offline        = false                // true if DBs already in download_path
    busco_min_species    = 2                    // abort if fewer species pass the gate

    // Report: 'auto' uses each matched GOI member as the %ID reference
    // (works for mixed Ath / Sly / Nbe / Cpe query lists). Or set Sly, Ath, Nbe, Cpe.
    reference_species_id = 'auto'

    // AlphaFold handoff (CPU stage) — GPU folding is workflows/alphafold.nf
    prepare_alphafold     = true
    af_input_mode         = 'goi_plus_orthologs'  // goi_only | goi_plus_orthologs | all_members
    af_min_pct_id         = 40.0
    af_max_models_per_og  = 6

    // Structure comparison (workflows/compare_structures.nf)
    af_min_plddt            = 50.0
    af_write_superimposed   = true
    usalign_bin             = 'USalign'   // optional; set '' to skip TM-score

    // Structure feature mapping extras (workflows/map_structure_features.nf)
    rsa_surface_cutoff          = 0.25
    interface_distance_cutoff   = 5.0
    interface_pae_cutoff        = 15.0
    run_surface                 = true
    run_multimer_interfaces     = true

    // Graft phenotype → evolutionary association (workflows/graft_phenotype.nf)
    // Can also be enabled at the end of main.nf
    run_graft_phenotype       = false
    graft_matrix              = "${projectDir}/data/graft_outcomes.example.tsv"
    graft_broad_threshold     = 0.5
    graft_foreground_trait    = 'broad_scion'  // broad_scion | broad_rootstock | broad_either
    graft_mantel_perms        = 999
    graft_asr_min_prob        = 0.9
    run_asr                   = true
    run_hyphy                 = false          // uses pipeline codon MSAs when build_codon_alignments=true
    run_convergence           = true
    build_codon_alignments    = true           // CDS download + protein-MSA-guided codon MSAs
    codon_min_sequences       = 3
    codon_alignments_dir      = null           // optional external codon MSAs override

    // Resources
    max_cpus   = 64
    max_memory = '500.GB'
    max_time   = '240.h'

    help = false
}

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
        conda.useMamba = true
        process.conda = "${projectDir}/conf/environment.yml"
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    docker {
        docker.enabled = true
    }

    // Remote high-memory / high-CPU server (local executor on a big box)
    hpc {
        includeConfig 'conf/hpc.config'
    }

    // SLURM cluster example — adjust partition/account on your site
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        process.clusterOptions = ''
        includeConfig 'conf/hpc.config'
    }

    // Local GPU server (for workflows/alphafold.nf only)
    gpu {
        includeConfig 'conf/gpu.config'
    }
}

includeConfig 'conf/base.config'

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) {
            return obj
        }
    }
}
